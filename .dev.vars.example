# LOCAL SERVER ONLY. Copy to .dev.vars and fill privately. Never commit .dev.vars.
# These must belong to a NEW PayPal Sandbox application, never a Live application.
PAYPAL_CLIENT_ID="replace_with_sandbox_client_id"
PAYPAL_CLIENT_SECRET="replace_with_sandbox_client_secret"
# AI binding is declared in wrangler.jsonc by the application; disabled by default.
# Parent/operator must explicitly enable bounded Workers AI use after review.
AI_ENABLED="false"
# Atomic SQLite reservation ceiling per UTC day; the hard maximum is 20.
AI_DAILY_LIMIT="20"
